{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "Hierarchical treemap of Australia's registered and employed healthcare workforce by profession group and profession in 2024.",
  "width": 1100,
  "height": 500,
  "background": "#fffdf7",
  "padding": 4,
  "autosize": {"type": "none", "contains": "padding", "resize": false},
  "data": [
    {
      "name": "tree",
      "url": "data/treemap_2024.csv",
      "format": {"type": "csv", "parse": {"headcount": "number", "group_total": "number"}},
      "transform": [
        {"type": "stratify", "key": "id", "parentKey": "parent"},
        {
          "type": "treemap",
          "field": "headcount",
          "sort": {"field": "value", "order": "descending"},
          "round": true,
          "method": "binary",
          "paddingInner": 3,
          "paddingOuter": 4,
          "paddingTop": 28,
          "size": [{"signal": "width"}, {"signal": "height"}]
        }
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [{"type": "filter", "expr": "datum.depth === 1"}]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [{"type": "filter", "expr": "datum.depth === 2"}]
    },
    {
      "name": "large_leaves",
      "source": "tree",
      "transform": [{"type": "filter", "expr": "datum.depth === 2 && datum.headcount >= 20000"}]
    }
  ],
  "scales": [
    {
      "name": "group_colour",
      "type": "ordinal",
      "domain": ["Nursing and midwifery", "Medicine", "Allied and other professions"],
      "range": ["#0b6257", "#4479a1", "#5b8f84"]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {"data": "groups"},
      "encode": {
        "enter": {
          "x": {"field": "x0"}, "y": {"field": "y0"}, "x2": {"field": "x1"}, "y2": {"field": "y1"},
          "fill": {"value": "#eef3f0"}, "stroke": {"value": "#fffdf7"}, "strokeWidth": {"value": 4},
          "tooltip": {"signal": "{'Profession group': datum.id, 'Combined headcount': format(datum.group_total, ',')}"}
        }
      }
    },
    {
      "type": "rect",
      "from": {"data": "leaves"},
      "encode": {
        "enter": {
          "x": {"field": "x0"}, "y": {"field": "y0"}, "x2": {"field": "x1"}, "y2": {"field": "y1"},
          "stroke": {"value": "#fffdf7"}, "strokeWidth": {"value": 1.5},
          "fill": {"scale": "group_colour", "field": "category"},
          "tooltip": {"signal": "{'Profession': datum.label, 'Headcount': format(datum.headcount, ','), 'Includes': datum.members && datum.members.length ? datum.members : 'Individual profession'}"}
        },
        "update": {"opacity": {"value": 0.94}},
        "hover": {"opacity": {"value": 1}, "strokeWidth": {"value": 3}}
      }
    },
    {
      "type": "text",
      "from": {"data": "groups"},
      "encode": {
        "enter": {
          "x": {"signal": "datum.x1 - datum.x0 < 80 ? (datum.x0 + datum.x1) / 2 : datum.x0 + 9"},
          "y": {"signal": "datum.x1 - datum.x0 < 80 ? datum.y1 - 10 : datum.y0 + 8"},
          "text": {"field": "label"},
          "font": {"value": "DM Sans, Arial, sans-serif"}, "fontSize": {"value": 12}, "fontWeight": {"value": 700},
          "fill": {"value": "#173f3a"},
          "angle": {"signal": "datum.x1 - datum.x0 < 80 ? -90 : 0"},
          "baseline": {"signal": "datum.x1 - datum.x0 < 80 ? 'middle' : 'top'"},
          "align": {"value": "left"}
        },
        "update": {"opacity": {"signal": "datum.x1 - datum.x0 > 80 || (datum.x1 - datum.x0 > 30 && datum.y1 - datum.y0 > 115) ? 1 : 0"}}
      }
    },
    {
      "type": "text",
      "from": {"data": "large_leaves"},
      "encode": {
        "enter": {
          "x": {"signal": "datum.x0 + 10"}, "y": {"signal": "datum.y0 + 10"},
          "text": {"signal": "datum.id === 'Medical Practitioners' ? 'Medical\\npractitioners' : datum.id === 'Occupational Therapists' ? 'Occupational\\ntherapists' : datum.id === 'Dental Practitioners' ? 'Dental\\npractitioners' : datum.id === 'Paramedicine Practitioners' ? 'Paramedicine\\npractitioners' : datum.id === 'Other smaller professions' ? 'Other smaller\\nprofessions' : datum.label"},
          "font": {"value": "DM Sans, Arial, sans-serif"}, "fontSize": {"value": 12.5}, "fontWeight": {"value": 700},
          "fill": {"value": "#ffffff"},
          "lineBreak": {"value": "\n"}, "lineHeight": {"value": 16}, "baseline": {"value": "top"}
        },
        "update": {"opacity": {"signal": "datum.x1 - datum.x0 > 95 && datum.y1 - datum.y0 > 70 ? 1 : 0"}}
      }
    },
    {
      "type": "text",
      "from": {"data": "large_leaves"},
      "encode": {
        "enter": {
          "x": {"signal": "datum.x0 + 10"},
          "y": {"signal": "datum.y0 + (datum.id === 'Medical Practitioners' || datum.id === 'Occupational Therapists' || datum.id === 'Dental Practitioners' || datum.id === 'Paramedicine Practitioners' || datum.id === 'Other smaller professions' ? 48 : 31)"},
          "text": {"signal": "format(datum.headcount, ',')"},
          "font": {"value": "DM Sans, Arial, sans-serif"}, "fontSize": {"value": 11.5},
          "fill": {"value": "#e8f4f0"}, "baseline": {"value": "top"}
        },
        "update": {"opacity": {"signal": "datum.x1 - datum.x0 > 95 && datum.y1 - datum.y0 > 82 ? 1 : 0"}}
      }
    }
  ]
}
