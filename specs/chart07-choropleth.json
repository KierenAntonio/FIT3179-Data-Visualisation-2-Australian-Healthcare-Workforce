{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive choropleth of full-time-equivalent healthcare workers per 100,000 residents by Australian state and territory.",
  "width": "container",
  "height": 470,
  "autosize": {"type": "fit", "contains": "padding", "resize": true},
  "projection": {"type": "equalEarth"},
  "params": [
    {
      "name": "profession_select",
      "value": "All professions",
      "bind": {
        "input": "select",
        "name": "Profession: ",
        "options": [
          "All professions",
          "Nurses and Midwives",
          "Medical Practitioners",
          "Physiotherapists",
          "Psychologists",
          "Pharmacists",
          "Occupational Therapists",
          "Dental Practitioners",
          "Paramedicine Practitioners",
          "Medical Radiation Practitioners",
          "Optometrists",
          "Chiropractors",
          "Podiatrists",
          "Chinese Medicine Practitioners",
          "Osteopaths",
          "ATSI Health Practitioners"
        ]
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/australia-states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {"url": "data/state_rates_2024.csv"},
            "key": "state",
            "fields": [
              "state",
              "state_code",
              "population",
              "All professions",
              "Nurses and Midwives",
              "Medical Practitioners",
              "Physiotherapists",
              "Psychologists",
              "Pharmacists",
              "Occupational Therapists",
              "Dental Practitioners",
              "Paramedicine Practitioners",
              "Medical Radiation Practitioners",
              "Optometrists",
              "Chiropractors",
              "Podiatrists",
              "Chinese Medicine Practitioners",
              "Osteopaths",
              "ATSI Health Practitioners"
            ]
          }
        },
        {"calculate": "datum[profession_select]", "as": "fte_per_100k"}
      ],
      "mark": {"type": "geoshape", "stroke": "#f7f4ec", "strokeWidth": 1.6},
      "encoding": {
        "color": {
          "field": "fte_per_100k",
          "type": "quantitative",
          "title": "FTE per 100,000",
          "scale": {"scheme": "tealblues", "unknown": "#d8dfdc"},
          "legend": {"orient": "bottom", "direction": "horizontal", "gradientLength": 250, "format": ",.0f"}
        },
        "tooltip": [
          {"field": "state", "title": "State or territory"},
          {"field": "fte_per_100k", "title": "FTE per 100,000", "format": ",.1f"},
          {"field": "population", "title": "2024 population", "format": ","}
        ]
      }
    },
    {
      "data": {"url": "data/state_metadata.csv"},
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#fffdf7",
        "stroke": "#173f3a",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "text": {"field": "state_code"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "legend": {"labelFont": "DM Sans", "titleFont": "DM Sans", "labelFontSize": 12, "titleFontSize": 12},
    "text": {"font": "DM Sans"}
  }
}
