{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Indexed workforce growth for six major and fast-growing registered health professions, 2020 to 2024.",
  "width": "container",
  "height": 330,
  "autosize": {"type": "fit", "contains": "padding", "resize": true},
  "data": {"url": "data/national_trend_2020_2024.csv"},
  "transform": [
    {
      "filter": {
        "field": "profession",
        "oneOf": [
          "Nurses and Midwives",
          "Medical Practitioners",
          "Physiotherapists",
          "Psychologists",
          "Occupational Therapists",
          "Paramedicine Practitioners"
        ]
      }
    },
    {
      "window": [{"op": "first_value", "field": "headcount", "as": "baseline"}],
      "sort": [{"field": "year", "order": "ascending"}],
      "groupby": ["profession"],
      "frame": [null, null]
    },
    {"calculate": "datum.headcount / datum.baseline * 100", "as": "growth_index"}
  ],
  "params": [
    {
      "name": "profession_highlight",
      "select": {"type": "point", "fields": ["profession"], "on": "mouseover", "clear": "mouseout"}
    }
  ],
  "mark": {"type": "line", "point": {"filled": true, "size": 55}, "strokeWidth": 2.6},
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {"labelAngle": 0, "tickSize": 0}
    },
    "y": {
      "field": "growth_index",
      "type": "quantitative",
      "title": "Growth index (2020 = 100)",
      "scale": {"domain": [95, 138]},
      "axis": {"grid": true, "format": ".0f"}
    },
    "color": {
      "field": "profession",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": [
          "Nurses and Midwives",
          "Medical Practitioners",
          "Physiotherapists",
          "Psychologists",
          "Occupational Therapists",
          "Paramedicine Practitioners"
        ],
        "range": ["#0b6257", "#3d8f82", "#d97757", "#7f6ca8", "#d0a13b", "#4479a1"]
      },
      "legend": {"orient": "bottom", "columns": 2, "labelLimit": 220}
    },
    "opacity": {
      "condition": {"param": "profession_highlight", "value": 1},
      "value": 0.68
    },
    "tooltip": [
      {"field": "profession", "type": "nominal", "title": "Profession"},
      {"field": "year", "type": "ordinal", "title": "Year"},
      {"field": "headcount", "type": "quantitative", "title": "Headcount", "format": ","},
      {"field": "growth_index", "type": "quantitative", "title": "Index", "format": ".1f"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFont": "DM Sans", "titleFont": "DM Sans", "labelFontSize": 12, "titleFontSize": 13, "gridColor": "#dce6e2", "domainColor": "#8ba29d"},
    "legend": {"labelFont": "DM Sans", "titleFont": "DM Sans", "labelFontSize": 12}
  }
}
