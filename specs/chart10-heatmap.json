{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap comparing profession-level full-time-equivalent workforce per 100,000 residents across Australian states and territories.",
  "width": "container",
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding", "resize": true},
  "data": {"url": "data/state_workforce_2024.csv"},
  "transform": [
    {"filter": "datum.profession !== 'All professions'"},
    {
      "lookup": "state",
      "from": {
        "data": {"url": "data/state_metadata.csv"},
        "key": "state",
        "fields": ["state_code", "population"]
      }
    },
    {"calculate": "datum.fte / datum.population * 100000", "as": "fte_per_100k"},
    {
      "joinaggregate": [
        {"op": "min", "field": "fte_per_100k", "as": "profession_min"},
        {"op": "max", "field": "fte_per_100k", "as": "profession_max"}
      ],
      "groupby": ["profession"]
    },
    {
      "calculate": "(datum.fte_per_100k - datum.profession_min) / (datum.profession_max - datum.profession_min)",
      "as": "relative_position"
    }
  ],
  "mark": {"type": "rect", "stroke": "#f7f4ec", "strokeWidth": 1.5},
  "encoding": {
    "x": {
      "field": "state_code",
      "type": "nominal",
      "title": null,
      "sort": ["NSW", "VIC", "QLD", "SA", "WA", "TAS", "ACT", "NT"],
      "axis": {"labelAngle": 0, "orient": "top", "tickSize": 0}
    },
    "y": {
      "field": "profession",
      "type": "nominal",
      "title": null,
      "sort": [
        "Nurses and Midwives",
        "Medical Practitioners",
        "Physiotherapists",
        "Psychologists",
        "Pharmacists",
        "Occupational Therapists",
        "Dental Practitioners",
        "Paramedicine Practitioners",
        "Medical Radiation Practitioners",
        "Optometrists",
        "Chiropractors",
        "Podiatrists",
        "Chinese Medicine Practitioners",
        "Osteopaths",
        "ATSI Health Practitioners"
      ],
      "axis": {"labelLimit": 215, "tickSize": 0}
    },
    "color": {
      "field": "relative_position",
      "type": "quantitative",
      "title": "Within-profession position",
      "scale": {"scheme": "tealblues", "domain": [0, 1], "unknown": "#d8dfdc"},
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 250,
        "values": [0, 1],
        "labelExpr": "datum.value === 0 ? 'Lower' : 'Higher'"
      }
    },
    "tooltip": [
      {"field": "profession", "title": "Profession"},
      {"field": "state", "title": "State or territory"},
      {"field": "fte", "title": "Total FTE", "format": ","},
      {"field": "fte_per_100k", "title": "FTE per 100,000", "format": ".1f"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"labelFont": "DM Sans", "titleFont": "DM Sans", "labelFontSize": 12, "titleFontSize": 13, "domain": false},
    "legend": {"labelFont": "DM Sans", "titleFont": "DM Sans", "labelFontSize": 12, "titleFontSize": 12}
  }
}
