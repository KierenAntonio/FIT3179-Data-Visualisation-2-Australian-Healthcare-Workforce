{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive proportional-symbol map of healthcare workforce headcount by Australian state and territory.",
  "width": "container",
  "height": 450,
  "autosize": {"type": "fit", "contains": "padding", "resize": true},
  "projection": {"type": "equalEarth"},
  "params": [
    {
      "name": "profession_select",
      "value": "All professions",
      "bind": {
        "input": "select",
        "name": "Profession: ",
        "options": [
          "All professions", "Nurses and Midwives", "Medical Practitioners", "Physiotherapists",
          "Psychologists", "Pharmacists", "Occupational Therapists", "Dental Practitioners",
          "Paramedicine Practitioners", "Medical Radiation Practitioners", "Optometrists",
          "Chiropractors", "Podiatrists", "Chinese Medicine Practitioners", "Osteopaths",
          "Aboriginal and Torres Strait Islander Health Practitioners"
        ]
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "data/australia-states.geojson",
        "format": {"type": "json", "property": "features"}
      },
      "mark": {"type": "geoshape", "fill": "#e7eeeb", "stroke": "#78918b", "strokeWidth": 1.2}
    },
    {
      "data": {"url": "data/state_workforce_2024.csv"},
      "transform": [
        {"filter": "datum.profession === profession_select"},
        {
          "lookup": "state",
          "from": {
            "data": {"url": "data/state_metadata.csv"},
            "key": "state",
            "fields": ["population", "longitude", "latitude"]
          }
        }
      ],
      "mark": {"type": "circle", "color": "#d97757", "opacity": 0.72, "stroke": "#7d3d2a", "strokeWidth": 1.1},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "headcount", "type": "quantitative", "title": "Headcount",
          "scale": {"type": "sqrt", "domain": [0, 220000], "range": [90, 6800], "clamp": true},
          "legend": {"orient": "bottom", "format": ",.0f", "values": [50000, 100000, 200000]}
        },
        "tooltip": [
          {"field": "state", "title": "State or territory"},
          {"field": "profession", "title": "Profession"},
          {"field": "headcount", "title": "Headcount", "format": ","},
          {"field": "fte", "title": "Total full-time equivalent", "format": ","}
        ]
      }
    },
    {
      "data": {"url": "data/state_metadata.csv"},
      "mark": {
        "type": "text", "fontSize": 9.5, "fontWeight": 700,
        "lineBreak": "|", "lineHeight": 11,
        "color": "#173f3a", "stroke": "#fffdf7", "strokeWidth": 3
      },
      "encoding": {
        "longitude": {"field": "map_label_longitude", "type": "quantitative"},
        "latitude": {"field": "map_label_latitude", "type": "quantitative"},
        "text": {"field": "map_label"}
      }
    },
    {
      "data": {"url": "data/state_metadata.csv"},
      "mark": {
        "type": "text", "fontSize": 9.5, "fontWeight": 700,
        "lineBreak": "|", "lineHeight": 11, "color": "#173f3a"
      },
      "encoding": {
        "longitude": {"field": "map_label_longitude", "type": "quantitative"},
        "latitude": {"field": "map_label_latitude", "type": "quantitative"},
        "text": {"field": "map_label"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "legend": {"labelFont": "DM Sans", "titleFont": "DM Sans", "labelFontSize": 12, "titleFontSize": 12},
    "text": {"font": "DM Sans"}
  }
}
